      { "name": "GlitterFeatureGrid", "type": "composite", "description": "Numbered capability list", "path": "src/components/composite/GlitterFeatureGrid.tsx" },
      { "name": "GlitterEditorialSplit", "type": "composite", "description": "Asymmetric editorial text split", "path": "src/components/composite/GlitterEditorialSplit.tsx" },
      { "name": "GlitterCTA", "type": "composite", "description": "Quiet closing call to action", "path": "src/components/composite/GlitterCTA.tsx" }
    ],
    "layout": []
  }
