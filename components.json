      { "name": "Nav", "type": "basic", "description": "Navigation landmark", "path": "src/components/basic/Nav.tsx", "props": { "className": { "type": "string", "required": false } } },
      { "name": "P", "type": "basic", "description": "Paragraph", "path": "src/components/basic/P.tsx", "props": { "className": { "type": "string", "required": false } } },
      { "name": "Section", "type": "basic", "description": "Section landmark", "path": "src/components/basic/Section.tsx", "props": { "className": { "type": "string", "required": false } } },
      { "name": "Span", "type": "basic", "description": "Inline text", "path": "src/components/basic/Span.tsx", "props": { "className": { "type": "string", "required": false } } },
      { "name": "Time", "type": "basic", "description": "Time semantic element", "path": "src/components/basic/Time.tsx", "props": { "className": { "type": "string", "required": false } } },
      { "name": "Textarea", "type": "basic", "description": "Multiline form input", "path": "src/components/basic/Textarea.tsx", "props": { "className": { "type": "string", "required": false } } },
      { "name": "Ul", "type": "basic", "description": "List", "path": "src/components/basic/Ul.tsx", "props": { "className": { "type": "string", "required": false } } }
