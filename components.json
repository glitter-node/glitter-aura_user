      { "name": "A", "type": "basic", "description": "Accessible link", "path": "src/components/basic/A.tsx", "props": { "href": { "type": "string", "required": false }, "className": { "type": "string", "required": false } } },
      { "name": "Button", "type": "basic", "description": "Button control", "path": "src/components/basic/Button.tsx", "props": { "className": { "type": "string", "required": false } } },
      { "name": "Div", "type": "basic", "description": "Generic layout container", "path": "src/components/basic/Div.tsx", "props": { "className": { "type": "string", "required": false } } },
      { "name": "Footer", "type": "basic", "description": "Footer landmark", "path": "src/components/basic/Footer.tsx", "props": { "className": { "type": "string", "required": false } } },
      { "name": "Form", "type": "basic", "description": "Form element", "path": "src/components/basic/Form.tsx", "props": { "className": { "type": "string", "required": false } } },
      { "name": "H1", "type": "basic", "description": "Primary heading", "path": "src/components/basic/H1.tsx", "props": { "className": { "type": "string", "required": false } } },
      { "name": "H2", "type": "basic", "description": "Section heading", "path": "src/components/basic/H2.tsx", "props": { "className": { "type": "string", "required": false } } },
