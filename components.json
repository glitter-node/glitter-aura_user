    "composite": [
      { "name": "GlitterHeader", "type": "composite", "description": "Responsive editorial site navigation", "path": "src/components/composite/GlitterHeader.tsx" },
      { "name": "GlitterFooter", "type": "composite", "description": "Generic identity and navigation footer", "path": "src/components/composite/GlitterFooter.tsx", "props": { "primaryNavLabel": { "type": "string", "required": false }, "utilityNavLabel": { "type": "string", "required": false } } },
