{
  "version": "1.0.0",
  "layout_name": "account/index",
  "extends": "_user_base",
  "meta": {
    "title": "$t:account.page_title",
    "auth_required": true
  },
  "data_sources": [
    {
      "id": "recentAuthoredPosts",
      "label_key": "$t:account.recent_posts.data_source",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/me/board-activities",
      "method": "GET",
      "params": {
        "activity_type": "authored",
        "sort": "latest",
        "per_page": 5,
        "page": 1
      },
      "auto_fetch": true,
      "auth_required": true,
      "loading_strategy": "progressive",
      "refetchOnMount": true
    }
  ],
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "local",
        "profileSaving": false,
        "profileError": null,
        "profileErrors": null,
        "profileSuccess": null,
        "passwordSaving": false,
        "passwordError": null,
        "passwordErrors": null,
        "passwordSuccess": null,
        "passwordForm": {
          "current_password": "",
          "password": "",
          "password_confirmation": ""
        }
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Section",
        "props": {
          "className": "glitter-container glitter-page-shell glitter-account-page"
        },
        "children": [
          {
            "type": "basic",
            "name": "Span",
            "props": {
              "className": "glitter-kicker"
            },
            "text": "$t:account.kicker"
          },
          {
            "type": "basic",
            "name": "H1",
            "props": {
              "className": "glitter-display glitter-section-title"
            },
            "text": "$t:account.title"
          },
          {
            "type": "basic",
            "name": "Nav",
            "props": {
              "className": "glitter-account-context-actions",
              "aria-label": "$t:account.context_actions"
            },
            "children": [
              { "type": "basic", "name": "A", "props": { "href": "/content", "className": "glitter-text-link" }, "text": "$t:account.browse_content" }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "if": "{{current_user?.loading}}",
            "props": { "className": "glitter-state", "role": "status", "aria-live": "polite" },
            "children": [{ "type": "basic", "name": "P", "text": "$t:state.loading" }]
          },
          {
            "type": "basic",
            "name": "Div",
            "if": "{{current_user?.error}}",
            "props": { "className": "glitter-state glitter-state-error", "role": "alert" },
            "children": [{ "type": "basic", "name": "P", "text": "$t:state.error" }, { "type": "basic", "name": "Button", "props": { "type": "button", "className": "glitter-text-button" }, "actions": [{ "type": "click", "handler": "refetchDataSource", "params": { "dataSourceId": "current_user" } }], "text": "$t:state.retry" }]
          },
          {
            "type": "basic",
            "name": "Div",
            "if": "{{current_user.data}}",
            "props": {
              "className": "glitter-account-grid"
            },
            "children": [
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "glitter-account-panel"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H2",
                    "props": {
                      "className": "glitter-subtitle"
                    },
                    "text": "$t:auth_account.identity_heading"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "glitter-section-description"
                    },
                    "text": "$t:auth_account.identity_intro"
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "glitter-account-details"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Div",
                        "children": [
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:auth_account.name"
                          },
                          {
                            "type": "basic",
                            "name": "P",
                            "text": "{{current_user.data.name}}"
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "children": [
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:auth_account.nickname"
                          },
                          {
                            "type": "basic",
                            "name": "P",
                            "text": "{{current_user.data.nickname ?? ''}}"
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "children": [
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:auth.email"
                          },
                          {
                            "type": "basic",
                            "name": "P",
                            "text": "{{current_user.data.email}}"
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "children": [
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:auth_account.joined"
                          },
                          {
                            "type": "basic",
                            "name": "P",
                            "text": "{{current_user.data.created_at ?? ''}}"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "glitter-account-panel"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H2",
                    "props": {
                      "className": "glitter-subtitle"
                    },
                    "text": "$t:auth_account.profile_heading"
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_local.profileSuccess}}",
                    "props": {
                      "className": "glitter-form-message glitter-form-message-success",
                      "role": "status"
                    },
                    "text": "{{_local.profileSuccess}}"
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_local.profileError && !_local.profileErrors}}",
                    "props": {
                      "className": "glitter-form-message glitter-form-message-error",
                      "role": "alert"
                    },
                    "text": "{{_local.profileError}}"
                  },
                  {
                    "type": "basic",
                    "name": "Form",
                    "dataKey": "profileForm",
                    "props": {
                      "className": "glitter-form"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": {
                          "htmlFor": "profile_name",
                          "className": "glitter-form-label"
                        },
                        "text": "$t:auth_account.name"
                      },
                      {
                        "type": "basic",
                        "name": "Input",
                        "props": {
                          "id": "profile_name",
                          "name": "name",
                          "type": "text",
                          "autoComplete": "name",
                          "required": true,
                          "disabled": "{{_local.profileSaving}}",
                          "className": "glitter-form-input"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "if": "{{_local.profileErrors?.name}}",
                        "props": { "className": "glitter-form-message glitter-form-message-error", "role": "alert" },
                        "text": "{{Array.isArray(_local.profileErrors.name) ? _local.profileErrors.name[0] : _local.profileErrors.name}}"
                      },
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": {
                          "htmlFor": "profile_nickname",
                          "className": "glitter-form-label"
                        },
                        "text": "$t:auth_account.nickname"
                      },
                      {
                        "type": "basic",
                        "name": "Input",
                        "props": {
                          "id": "profile_nickname",
                          "name": "nickname",
                          "type": "text",
                          "autoComplete": "nickname",
                          "disabled": "{{_local.profileSaving}}",
                          "className": "glitter-form-input"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": {
                          "htmlFor": "profile_email",
                          "className": "glitter-form-label"
                        },
                        "text": "$t:auth.email"
                      },
                      {
                        "type": "basic",
                        "name": "Input",
                        "props": {
                          "id": "profile_email",
                          "name": "email",
                          "type": "email",
                          "autoComplete": "email",
                          "required": true,
                          "disabled": "{{_local.profileSaving}}",
                          "className": "glitter-form-input"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "if": "{{_local.profileErrors?.email}}",
                        "props": { "className": "glitter-form-message glitter-form-message-error", "role": "alert" },
                        "text": "{{Array.isArray(_local.profileErrors.email) ? _local.profileErrors.email[0] : _local.profileErrors.email}}"
                      },
                      {
                        "type": "basic",
                        "name": "Label",
                        "props": {
                          "htmlFor": "profile_bio",
                          "className": "glitter-form-label"
                        },
                        "text": "$t:auth_account.bio"
                      },
                      {
                        "type": "basic",
                        "name": "Textarea",
                        "props": {
                          "id": "profile_bio",
                          "name": "bio",
                          "disabled": "{{_local.profileSaving}}",
                          "className": "glitter-form-input glitter-form-textarea"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "Button",
                        "props": {
                          "type": "submit",
                          "disabled": "{{_local.profileSaving}}",
                          "className": "glitter-solid glitter-action-link"
                        },
                        "text": "$t:auth_account.save_profile"
                      }
                    ],
                    "actions": [
                      {
                        "type": "submit",
                        "handler": "sequence",
                        "actions": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "profileSaving": true,
                              "profileSuccess": null,
                              "profileError": null,
                              "profileErrors": null
                            }
                          },
                          {
                            "handler": "apiCall",
                            "auth_required": true,
                            "target": "/api/me",
                            "params": {
                              "method": "PUT",
                              "body": "{{{name: _local.profileForm?.name, nickname: _local.profileForm?.nickname, email: _local.profileForm?.email, bio: _local.profileForm?.bio}}}"
                            },
                            "onSuccess": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "profileSuccess": "$t:auth_account.profile_saved",
                                  "profileError": null,
                                  "profileErrors": null,
                                  "profileSaving": false
                                }
                              },
                              {
                                "handler": "refetchDataSource",
                                "params": {
                                  "dataSourceId": "current_user"
                                }
                              }
                            ],
                            "onError": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "profileSuccess": null,
                                  "profileError": "$t:auth_account.profile_failed",
                                  "profileErrors": "{{error.response?.errors ?? error.errors}}",
                                  "profileSaving": false
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "glitter-account-panel"
            },
            "children": [
              {
                "type": "basic",
                "name": "H2",
                "props": {
                  "className": "glitter-subtitle"
                },
                "text": "$t:auth_account.security_heading"
              },
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_local.passwordSuccess}}",
                "props": {
                  "className": "glitter-form-message glitter-form-message-success",
                  "role": "status"
                },
                "text": "{{_local.passwordSuccess}}"
              },
                  {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_local.passwordError && !_local.passwordErrors}}",
                "props": {
                  "className": "glitter-form-message glitter-form-message-error",
                  "role": "alert"
                },
                "text": "{{_local.passwordError}}"
              },
              {
                "type": "basic",
                "name": "Form",
                "dataKey": "passwordForm",
                "props": {
                  "className": "glitter-form"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "htmlFor": "current_password",
                      "className": "glitter-form-label"
                    },
                    "text": "$t:auth_account.current_password"
                  },
                      {
                        "type": "basic",
                        "name": "Input",
                    "props": {
                      "id": "current_password",
                      "name": "current_password",
                      "type": "password",
                      "autoComplete": "current-password",
                      "required": true,
                      "disabled": "{{_local.passwordSaving}}",
                          "className": "glitter-form-input"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "if": "{{_local.passwordErrors?.current_password}}",
                        "props": { "className": "glitter-form-message glitter-form-message-error", "role": "alert" },
                        "text": "{{Array.isArray(_local.passwordErrors.current_password) ? _local.passwordErrors.current_password[0] : _local.passwordErrors.current_password}}"
                      },
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "htmlFor": "new_password",
                      "className": "glitter-form-label"
                    },
                    "text": "$t:auth_account.new_password"
                  },
                      {
                        "type": "basic",
                        "name": "Input",
                    "props": {
                      "id": "new_password",
                      "name": "password",
                      "type": "password",
                      "autoComplete": "new-password",
                      "required": true,
                      "disabled": "{{_local.passwordSaving}}",
                          "className": "glitter-form-input"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "if": "{{_local.passwordErrors?.password}}",
                        "props": { "className": "glitter-form-message glitter-form-message-error", "role": "alert" },
                        "text": "{{Array.isArray(_local.passwordErrors.password) ? _local.passwordErrors.password[0] : _local.passwordErrors.password}}"
                      },
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "htmlFor": "password_confirmation",
                      "className": "glitter-form-label"
                    },
                    "text": "$t:auth_account.password_confirmation"
                  },
                      {
                        "type": "basic",
                        "name": "Input",
                    "props": {
                      "id": "password_confirmation",
                      "name": "password_confirmation",
                      "type": "password",
                      "autoComplete": "new-password",
                      "required": true,
                      "disabled": "{{_local.passwordSaving}}",
                          "className": "glitter-form-input"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "if": "{{_local.passwordErrors?.password_confirmation}}",
                        "props": { "className": "glitter-form-message glitter-form-message-error", "role": "alert" },
                        "text": "{{Array.isArray(_local.passwordErrors.password_confirmation) ? _local.passwordErrors.password_confirmation[0] : _local.passwordErrors.password_confirmation}}"
                      },
                  {
                    "type": "basic",
                    "name": "Button",
                    "props": {
                      "type": "submit",
                      "disabled": "{{_local.passwordSaving}}",
                      "className": "glitter-solid glitter-action-link"
                    },
                    "text": "$t:auth_account.change_password"
                  }
                ],
                "actions": [
                  {
                    "type": "submit",
                    "handler": "sequence",
                    "actions": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "passwordSaving": true,
                          "passwordSuccess": null,
                          "passwordError": null,
                          "passwordErrors": null
                        }
                      },
                      {
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/me/password",
                        "params": {
                          "method": "PUT",
                          "body": "{{_local.passwordForm}}"
                        },
                        "onSuccess": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "passwordSuccess": "$t:auth_account.password_saved",
                              "passwordError": null,
                              "passwordErrors": null,
                              "passwordSaving": false,
                              "passwordForm": {
                                "current_password": "",
                                "password": "",
                                "password_confirmation": ""
                              }
                            }
                          }
                        ],
                        "onError": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "passwordSuccess": null,
                              "passwordError": "$t:auth_account.password_failed",
                              "passwordErrors": "{{error.response?.errors ?? error.errors}}",
                              "passwordSaving": false
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "basic",
        "name": "Section",
        "props": {
          "className": "glitter-account-recent-posts",
          "aria-labelledby": "account-recent-posts-title"
        },
        "children": [
          {
            "type": "basic",
            "name": "H2",
            "props": {
              "id": "account-recent-posts-title",
              "className": "glitter-subtitle"
            },
            "text": "$t:account.recent_posts.heading"
          },
          {
            "type": "basic",
            "name": "Div",
            "if": "{{recentAuthoredPosts?.loading}}",
            "props": {
              "className": "glitter-state",
              "role": "status",
              "aria-live": "polite"
            },
            "children": [
              {
                "type": "basic",
                "name": "P",
                "text": "$t:account.recent_posts.loading"
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "if": "{{recentAuthoredPosts?.error}}",
            "props": {
              "className": "glitter-state glitter-state-error",
              "role": "alert"
            },
            "children": [
              {
                "type": "basic",
                "name": "P",
                "text": "$t:account.recent_posts.error"
              },
              {
                "type": "basic",
                "name": "Button",
                "props": { "type": "button", "className": "glitter-text-button" },
                "actions": [{ "type": "click", "handler": "refetchDataSource", "params": { "dataSourceId": "recentAuthoredPosts" } }],
                "text": "$t:state.retry"
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "if": "{{!recentAuthoredPosts?.loading && !recentAuthoredPosts?.error && (recentAuthoredPosts?.data?.data?.length ?? 0) === 0}}",
            "props": {
              "className": "glitter-state glitter-state-empty"
            },
            "children": [
              {
                "type": "basic",
                "name": "P",
                "text": "$t:account.recent_posts.empty"
              }
            ]
          },
          {
            "type": "basic",
            "name": "Ul",
            "if": "{{!recentAuthoredPosts?.loading && !recentAuthoredPosts?.error && (recentAuthoredPosts?.data?.data?.length ?? 0) > 0}}",
            "props": {
              "className": "glitter-post-list"
            },
            "children": [
              {
                "type": "basic",
                "name": "Li",
                "iteration": {
                  "source": "{{recentAuthoredPosts?.data?.data ?? []}}",
                  "item_var": "post"
                },
                "props": {
                  "className": "glitter-post-item"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "A",
                    "if": "{{post.status === 'published' && !post.is_secret && post.board_slug && post.id}}",
                    "props": {
                      "href": "/community/{{post.board_slug}}/{{post.id}}",
                      "className": "glitter-post-link"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "H3",
                        "props": {
                          "className": "glitter-post-title"
                        },
                        "if": "{{post.title}}",
                        "text": "{{post.title}}"
                      },
                      {
                        "type": "basic",
                        "name": "H3",
                        "props": {
                          "className": "glitter-post-title"
                        },
                        "if": "{{!post.title}}",
                        "text": "$t:account.recent_posts.untitled"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "if": "{{post.content_plain}}",
                        "props": { "className": "glitter-post-excerpt" },
                        "text": "{{post.content_plain}}"
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "glitter-post-meta"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "A",
                            "if": "{{post.board_name && post.board_slug}}",
                            "props": { "href": "/community/{{post.board_slug}}", "className": "glitter-text-link" },
                            "text": "{{post.board_name}}"
                          },
                          { "type": "basic", "name": "Time", "if": "{{post.created_at}}", "props": { "datetime": "{{post.created_at}}" }, "text": "{{post.created_at_formatted ?? post.created_at ?? ''}}" },
                          { "type": "basic", "name": "Span", "if": "{{post.comment_count != null}}", "text": "$t:account.recent_posts.comments|count={{post.comment_count}}" },
                          { "type": "basic", "name": "Span", "if": "{{post.view_count != null}}", "text": "$t:account.recent_posts.views|count={{post.view_count}}" }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{!(post.status === 'published' && !post.is_secret && post.board_slug && post.id)}}",
                    "props": {
                      "className": "glitter-post-link"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "H3",
                        "props": {
                          "className": "glitter-post-title"
                        },
                        "if": "{{post.title}}",
                        "text": "{{post.title}}"
                      },
                      {
                        "type": "basic",
                        "name": "H3",
                        "props": {
                          "className": "glitter-post-title"
                        },
                        "if": "{{!post.title}}",
                        "text": "$t:account.recent_posts.untitled"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "if": "{{post.content_plain}}",
                        "props": { "className": "glitter-post-excerpt" },
                        "text": "{{post.content_plain}}"
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "glitter-post-meta"
                        },
                        "children": [
                          { "type": "basic", "name": "A", "if": "{{post.board_name && post.board_slug}}", "props": { "href": "/community/{{post.board_slug}}", "className": "glitter-text-link" }, "text": "{{post.board_name}}" },
                          {
                            "type": "basic",
                            "name": "Time",
                            "if": "{{post.created_at}}",
                            "props": {
                              "datetime": "{{post.created_at}}"
                            },
                            "text": "{{post.created_at_formatted ?? post.created_at ?? ''}}"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{post.status === 'blinded'}}",
                            "text": "$t:account.recent_posts.status_blinded"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{post.status === 'deleted'}}",
                            "text": "$t:account.recent_posts.status_deleted"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{post.is_secret}}",
                            "text": "$t:account.recent_posts.status_private"
                          },
                          { "type": "basic", "name": "Span", "if": "{{post.comment_count != null}}", "text": "$t:account.recent_posts.comments|count={{post.comment_count}}" },
                          { "type": "basic", "name": "Span", "if": "{{post.view_count != null}}", "text": "$t:account.recent_posts.views|count={{post.view_count}}" }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
