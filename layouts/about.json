{
  "version": "1.0.1", "layout_name": "about", "extends": "_user_base", "meta": { "title": "$t:about.page_title" },
  "slots": { "content": [{ "type": "basic", "name": "Section", "props": { "className": "glitter-container glitter-section glitter-page-shell glitter-about-page" }, "children": [
    { "type": "composite", "name": "GlitterSectionHeader", "props": { "eyebrow": "$t:about.kicker", "title": "$t:about.title", "description": "$t:about.intro", "headingLevel": "h1", "className": "glitter-about-intro" } },
    { "type": "composite", "name": "GlitterEditorialSplit", "props": { "className": "glitter-about-identity", "eyebrow": "$t:about.identity_kicker", "title": "$t:about.identity_title", "body": "$t:about.identity_body", "note": "$t:about.identity_note" } },
    { "type": "basic", "name": "Section", "props": { "className": "glitter-about-principles", "aria-labelledby": "glitter-about-principles-title" }, "children": [{ "type": "composite", "name": "GlitterSectionHeader", "props": { "id": "glitter-about-principles-title", "eyebrow": "$t:about.principles_kicker", "title": "$t:about.principles_title", "headingLevel": "h2" } }, { "type": "composite", "name": "GlitterFeatureGrid", "props": { "items": [{ "title": "$t:about.principle_one_title", "body": "$t:about.principle_one_body" }, { "title": "$t:about.principle_two_title", "body": "$t:about.principle_two_body" }, { "title": "$t:about.principle_three_title", "body": "$t:about.principle_three_body" }] } }] },
    { "type": "composite", "name": "GlitterEditorialSplit", "props": { "className": "glitter-about-rhythms", "eyebrow": "$t:about.rhythms_kicker", "title": "$t:about.rhythms_title", "body": "$t:about.rhythms_body", "note": "$t:about.rhythms_note" } },
    { "type": "basic", "name": "Section", "props": { "className": "glitter-about-continuation", "aria-labelledby": "glitter-about-continuation-title" }, "children": [{ "type": "basic", "name": "H2", "props": { "id": "glitter-about-continuation-title", "className": "glitter-display glitter-about-continuation-title" }, "text": "$t:about.continuation_title" }, { "type": "basic", "name": "P", "props": { "className": "glitter-about-continuation-body" }, "text": "$t:about.continuation_body" }, { "type": "basic", "name": "Div", "props": { "className": "glitter-about-actions" }, "children": [{ "type": "basic", "name": "A", "props": { "href": "/content", "className": "glitter-solid glitter-action-link" }, "text": "$t:about.content_action" }, { "type": "basic", "name": "A", "props": { "href": "/search", "className": "glitter-text-link" }, "text": "$t:about.search_action" }] }] }
  ] }] }
}
