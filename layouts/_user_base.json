{
  "version": "1.0.0",
  "layout_name": "_user_base",
  "meta": { "title": "$t:base.title", "is_base": true },
  "data_sources": [{ "id": "current_user", "label_key": "$t:auth_account.current_user_data_source", "type": "api", "endpoint": "/api/auth/user", "method": "GET", "auto_fetch": true, "auth_required": true, "loading_strategy": "progressive", "initGlobal": "currentUser", "initLocal": { "key": "profileForm", "path": "data" }, "fallback": { "data": null } }],
  "components": [{ "type": "basic", "name": "Div", "props": { "className": "glitter-root min-h-screen flex flex-col" }, "children": [
    { "type": "composite", "name": "GlitterHeader", "if": "{{!_global.currentUser?.uuid}}", "props": { "brandName": "$t:brand.name", "authenticated": false, "menuLabel": "$t:nav.open_menu", "closeLabel": "$t:nav.close_menu", "themeToggleDarkLabel": "$t:nav.switch_to_dark", "themeToggleLightLabel": "$t:nav.switch_to_light", "loginLabel": "$t:nav.login", "accountLabel": "$t:nav.login", "loginHref": "/login", "navItems": [{ "label": "$t:nav.about", "href": "/about" }, { "label": "$t:nav.content", "href": "/content", "activePaths": ["/community", "/board"] }, { "label": "$t:nav.search", "href": "/search" }] } },
    { "type": "composite", "name": "GlitterHeader", "if": "{{_global.currentUser?.uuid}}", "actions": [{ "event": "onLogout", "handler": "logout", "target": "user", "onSuccess": [{ "handler": "navigate", "params": { "path": "/" } }] }], "props": { "brandName": "$t:brand.name", "authenticated": true, "nickname": "{{_global.currentUser?.nickname}}", "name": "{{_global.currentUser?.name}}", "isAdmin": "{{_global.currentUser?.is_admin}}", "menuLabel": "$t:nav.open_menu", "closeLabel": "$t:nav.close_menu", "themeToggleDarkLabel": "$t:nav.switch_to_dark", "themeToggleLightLabel": "$t:nav.switch_to_light", "loginLabel": "$t:nav.account", "accountLabel": "$t:nav.account", "adminLabel": "$t:navigation_labels.admin", "myPageLabel": "$t:navigation_labels.my_page", "logoutLabel": "$t:auth_account.logout", "myPageHref": "/mypage/profile", "myPageActivePaths": ["/account"], "navItems": [{ "label": "$t:nav.about", "href": "/about" }, { "label": "$t:nav.content", "href": "/content", "activePaths": ["/community", "/board"] }, { "label": "$t:nav.search", "href": "/search" }] } },
    { "type": "basic", "name": "Main", "props": { "className": "glitter-main flex-1" }, "children": [{ "type": "basic", "name": "Div", "slot": "content", "children": [] }] },
    { "type": "composite", "name": "GlitterFooter", "props": { "siteName": "$t:brand.name", "description": "$t:footer.description", "copyright": "$t:footer.copyright", "primaryNavLabel": "$t:footer.primary_navigation", "utilityNavLabel": "$t:footer.utility_navigation", "primaryLinks": [{ "label": "$t:nav.about", "href": "/about" }, { "label": "$t:nav.content", "href": "/content" }, { "label": "$t:nav.search", "href": "/search" }], "utilityLinks": [{ "label": "$t:footer.policy", "href": "/pages/policy" }, { "label": "$t:footer.contact", "href": "/pages/contact" }] } }
  ] }]
}
