{
  "version": "1.0.0",
  "layout_name": "auth/reset_password",
  "extends": "_user_base",
  "meta": {
    "title": "$t:auth.reset_password_title",
    "guest_only": true
  },
  "data_sources": [
    {
      "id": "tokenValidation",
      "type": "api",
      "endpoint": "/api/auth/validate-reset-token",
      "method": "POST",
      "auto_fetch": true,
      "auth_required": false,
      "loading_strategy": "blocking",
      "params": {
        "token": "{{query.token ?? ''}}",
        "email": "{{query.email ?? ''}}"
      },
      "initLocal": {
        "tokenValid": "{{data.valid ?? false}}",
        "tokenError": "{{!(data.valid ?? false)}}"
      },
      "errorHandling": {
        "default": {
          "handler": "setState",
          "params": {
            "target": "local",
            "tokenError": true
          }
        }
      }
    }
  ],
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "local",
        "resetForm": {
          "password": "",
          "password_confirmation": ""
        },
        "isSubmitting": false,
        "success": false,
        "tokenError": false,
        "resetError": null,
        "resetErrors": null
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Section",
        "props": {
          "className": "glitter-container glitter-page-shell glitter-page-content glitter-auth-page glitter-recovery-page"
        },
        "children": [
          {
            "type": "basic",
            "name": "Span",
            "props": {
              "className": "glitter-kicker"
            },
            "text": "$t:auth.reset_password_kicker"
          },
          {
            "type": "basic",
            "name": "H1",
            "props": {
              "className": "glitter-display glitter-section-title"
            },
            "text": "$t:auth.reset_password_heading"
          },
          {
            "type": "basic",
            "name": "P",
            "props": {
              "className": "glitter-section-description"
            },
            "text": "$t:auth.reset_password_intro"
          },
          {
            "type": "basic",
            "name": "Div",
            "if": "{{_local.tokenError}}",
            "props": {
              "className": "glitter-form-message glitter-form-message-error",
              "role": "alert"
            },
            "text": "$t:auth.reset_password_invalid"
          },
          {
            "type": "basic",
            "name": "Div",
            "if": "{{_local.success}}",
            "props": {
              "className": "glitter-form-message glitter-form-message-success",
              "role": "status"
            },
            "text": "$t:auth.reset_password_success"
          },
          {
            "type": "basic",
            "name": "Form",
            "if": "{{!_local.success && !_local.tokenError && _local.tokenValid}}",
            "dataKey": "resetForm",
            "props": {
              "className": "glitter-form"
            },
            "children": [
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_local.resetError && !_local.resetErrors}}",
                "props": {
                  "className": "glitter-form-message glitter-form-message-error",
                  "role": "alert"
                },
                "text": "{{_local.resetError}}"
              },
              {
                "type": "basic",
                "name": "Label",
                "props": {
                  "htmlFor": "reset_password",
                  "className": "glitter-form-label"
                },
                "text": "$t:auth_account.new_password"
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "id": "reset_password",
                  "name": "password",
                  "type": "password",
                  "autoComplete": "new-password",
                  "required": true,
                  "disabled": "{{_local.isSubmitting}}",
                  "className": "glitter-form-input"
                }
              },
              {
                "type": "basic",
                "name": "P",
                "if": "{{_local.resetErrors?.password}}",
                "props": {
                  "className": "glitter-form-message glitter-form-message-error"
                },
                "text": "{{Array.isArray(_local.resetErrors.password) ? _local.resetErrors.password[0] : _local.resetErrors.password}}"
              },
              {
                "type": "basic",
                "name": "Label",
                "props": {
                  "htmlFor": "reset_password_confirmation",
                  "className": "glitter-form-label"
                },
                "text": "$t:auth_account.password_confirmation"
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "id": "reset_password_confirmation",
                  "name": "password_confirmation",
                  "type": "password",
                  "autoComplete": "new-password",
                  "required": true,
                  "disabled": "{{_local.isSubmitting}}",
                  "className": "glitter-form-input"
                }
              },
              {
                "type": "basic",
                "name": "P",
                "if": "{{_local.resetErrors?.password_confirmation}}",
                "props": {
                  "className": "glitter-form-message glitter-form-message-error"
                },
                "text": "{{Array.isArray(_local.resetErrors.password_confirmation) ? _local.resetErrors.password_confirmation[0] : _local.resetErrors.password_confirmation}}"
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "submit",
                  "disabled": "{{_local.isSubmitting}}",
                  "className": "glitter-solid glitter-action-link"
                },
                "text": "$t:auth.reset_password_submit"
              }
            ],
            "actions": [
              {
                "type": "submit",
                "handler": "sequence",
                "actions": [
                  {
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "isSubmitting": true,
                      "resetError": null,
                      "resetErrors": null
                    }
                  },
                  {
                    "handler": "apiCall",
                    "auth_required": false,
                    "target": "/api/auth/reset-password",
                    "params": {
                      "method": "POST",
                      "body": {
                        "token": "{{query.token ?? ''}}",
                        "email": "{{query.email ?? ''}}",
                        "password": "{{form.password}}",
                        "password_confirmation": "{{form.password_confirmation}}"
                      }
                    },
                    "onSuccess": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "isSubmitting": false,
                          "success": true
                        }
                      }
                    ],
                    "onError": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "isSubmitting": false,
                          "resetError": "{{error.message ?? ''}}",
                          "resetErrors": "{{error.response?.errors ?? error.errors}}"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "P",
            "props": {
              "className": "glitter-auth-switch glitter-recovery-return"
            },
            "children": [
              {
                "type": "basic",
                "name": "A",
                "props": {
                  "href": "/login",
                  "className": "glitter-text-link"
                },
                "text": "$t:auth.login_link"
              }
            ]
          },
          {
            "type": "basic",
            "name": "P",
            "if": "{{_local.tokenError}}",
            "props": {
              "className": "glitter-auth-switch"
            },
            "children": [
              {
                "type": "basic",
                "name": "A",
                "props": {
                  "href": "/forgot-password",
                  "className": "glitter-text-link"
                },
                "text": "$t:auth.forgot_password_link"
              }
            ]
          }
        ]
      }
    ]
  }
}
