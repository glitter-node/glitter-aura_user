{
  "version": "1.0.0",
  "layout_name": "auth/login",
  "extends": "_user_base",
  "meta": {
    "title": "$t:auth.login_title",
    "guest_only": true
  },
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "local",
        "loginForm": {
          "email": "",
          "password": "",
          "code": ""
        },
        "isLoggingIn": false,
        "loginError": null,
        "loginErrors": null,
        "twoFactor": null
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Section",
        "props": {
          "className": "glitter-container glitter-page-shell glitter-page-content glitter-auth-page glitter-login-page"
        },
        "children": [
          {
            "type": "basic",
            "name": "Span",
            "props": {
              "className": "glitter-kicker"
            },
            "text": "$t:auth.kicker"
          },
          {
            "type": "basic",
            "name": "H1",
            "props": {
              "className": "glitter-display glitter-section-title glitter-internal-title"
            },
            "text": "$t:auth.login_heading"
          },
          {
            "type": "basic",
            "name": "P",
            "props": {
              "className": "glitter-section-description"
            },
            "text": "$t:auth_account.login_intro"
          },
          {
            "type": "basic",
            "name": "Form",
            "dataKey": "loginForm",
            "props": {
              "className": "glitter-form"
            },
            "children": [
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_local.loginError}}",
                "props": {
                  "className": "glitter-form-message glitter-form-message-error",
                  "role": "alert"
                },
                "text": "{{_local.loginError}}"
              },
              {
                "type": "basic",
                "name": "Div",
                "if": "{{!_local.twoFactor?.required}}",
                "children": [
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "htmlFor": "login_email",
                      "className": "glitter-form-label"
                    },
                    "text": "$t:auth.email"
                  },
                  {
                    "type": "basic",
                    "name": "Input",
                    "props": {
                      "id": "login_email",
                      "name": "email",
                      "type": "email",
                      "autoComplete": "email",
                      "required": true,
                      "disabled": "{{_local.isLoggingIn}}",
                      "className": "glitter-form-input"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "if": "{{_local.loginErrors?.email}}",
                    "props": {
                      "className": "glitter-form-message glitter-form-message-error"
                    },
                    "text": "{{Array.isArray(_local.loginErrors.email) ? _local.loginErrors.email[0] : _local.loginErrors.email}}"
                  },
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "htmlFor": "login_password",
                      "className": "glitter-form-label"
                    },
                    "text": "$t:auth.password"
                  },
                  {
                    "type": "basic",
                    "name": "Input",
                    "props": {
                      "id": "login_password",
                      "name": "password",
                      "type": "password",
                      "autoComplete": "current-password",
                      "required": true,
                      "disabled": "{{_local.isLoggingIn}}",
                      "className": "glitter-form-input"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "if": "{{_local.loginErrors?.password}}",
                    "props": {
                      "className": "glitter-form-message glitter-form-message-error"
                    },
                    "text": "{{Array.isArray(_local.loginErrors.password) ? _local.loginErrors.password[0] : _local.loginErrors.password}}"
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_local.twoFactor?.required}}",
                "children": [
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "htmlFor": "login_code",
                      "className": "glitter-form-label"
                    },
                    "text": "$t:auth_account.two_factor_code"
                  },
                  {
                    "type": "basic",
                    "name": "Input",
                    "props": {
                      "id": "login_code",
                      "name": "code",
                      "type": "text",
                      "inputMode": "numeric",
                      "autoComplete": "one-time-code",
                      "required": true,
                      "disabled": "{{_local.isLoggingIn}}",
                      "className": "glitter-form-input"
                    }
                  }
                  ,{
                    "type": "basic",
                    "name": "P",
                    "if": "{{_local.loginErrors?.code}}",
                    "props": { "className": "glitter-form-message glitter-form-message-error", "role": "alert" },
                    "text": "{{Array.isArray(_local.loginErrors.code) ? _local.loginErrors.code[0] : _local.loginErrors.code}}"
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "submit",
                  "disabled": "{{_local.isLoggingIn}}",
                  "className": "glitter-solid glitter-action-link"
                },
                "text": "$t:auth.login_submit"
              }
            ],
            "actions": [
              {
                "type": "submit",
                "handler": "sequence",
                "actions": [
                  {
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "isLoggingIn": true,
                      "loginError": null,
                      "loginErrors": null
                    }
                  },
                  {
                    "handler": "login",
                    "target": "user",
                    "if": "{{!_local.twoFactor?.required}}",
                    "params": {
                      "body": {
                        "email": "{{form.email}}",
                        "password": "{{form.password}}"
                      }
                    },
                    "onSuccess": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "isLoggingIn": false,
                          "twoFactor": "{{response.two_factor_required ? {required: true, challenge_id: response.challenge_id, expires_at: response.expires_at} : null}}"
                        }
                      },
                      {
                        "handler": "navigate",
                        "if": "{{!response.two_factor_required}}",
                        "params": {
                          "path": "/"
                        }
                      }
                    ],
                    "onError": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "isLoggingIn": false,
                          "loginError": "$t:auth_account.login_failed",
                          "loginErrors": "{{error.response?.errors ?? error.errors}}"
                        }
                      }
                    ]
                  },
                  {
                    "handler": "loginTwoFactor",
                    "target": "user",
                    "if": "{{_local.twoFactor?.required}}",
                    "params": {
                      "body": {
                        "challenge_id": "{{_local.twoFactor.challenge_id}}",
                        "code": "{{form.code}}"
                      }
                    },
                    "onSuccess": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "global",
                          "currentUser": "{{response.user}}"
                        }
                      },
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "isLoggingIn": false,
                          "twoFactor": null
                        }
                      },
                      {
                        "handler": "navigate",
                        "params": {
                          "path": "/"
                        }
                      }
                    ],
                    "onError": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "isLoggingIn": false,
                          "loginError": "$t:auth_account.two_factor_failed",
                          "loginErrors": "{{error.response?.errors ?? error.errors}}"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "glitter-login-secondary"
            },
            "children": [
              {
                "type": "basic",
                "name": "P",
                "props": {
                  "className": "glitter-auth-switch"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Span",
                    "text": "$t:auth.no_account"
                  },
                  {
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/register",
                      "className": "glitter-text-link"
                    },
                    "text": "$t:auth.register_link"
                  }
                ]
              },
              {
                "type": "basic",
                "name": "P",
                "props": {
                  "className": "glitter-auth-switch"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "A",
                    "props": {
                      "href": "/forgot-password",
                      "className": "glitter-text-link"
                    },
                    "text": "$t:auth.forgot_password_link"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
