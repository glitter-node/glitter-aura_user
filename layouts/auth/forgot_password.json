{
  "version": "1.0.0",
  "layout_name": "auth/forgot_password",
  "extends": "_user_base",
  "meta": {
    "title": "$t:auth.forgot_password_title",
    "guest_only": true
  },
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "local",
        "forgotForm": {
          "email": ""
        },
        "isSubmitting": false,
        "success": false,
        "forgotError": null,
        "forgotErrors": null
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Section",
        "props": {
          "className": "glitter-container glitter-page-shell glitter-page-content glitter-auth-page glitter-recovery-page"
        },
        "children": [
          {
            "type": "basic",
            "name": "Span",
            "props": {
              "className": "glitter-kicker"
            },
            "text": "$t:auth.forgot_password_kicker"
          },
          {
            "type": "basic",
            "name": "H1",
            "props": {
              "className": "glitter-display glitter-section-title glitter-internal-title"
            },
            "text": "$t:auth.forgot_password_heading"
          },
          {
            "type": "basic",
            "name": "P",
            "props": {
              "className": "glitter-section-description"
            },
            "text": "$t:auth.forgot_password_intro"
          },
          {
            "type": "basic",
            "name": "Div",
            "if": "{{_local.success}}",
            "props": {
              "className": "glitter-form-message glitter-form-message-success",
              "role": "status"
            },
            "text": "$t:auth.forgot_password_success"
          },
          {
            "type": "basic",
            "name": "Form",
            "if": "{{!_local.success}}",
            "dataKey": "forgotForm",
            "props": {
              "className": "glitter-form"
            },
            "children": [
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_local.forgotError && !_local.forgotErrors}}",
                "props": {
                  "className": "glitter-form-message glitter-form-message-error",
                  "role": "alert"
                },
                "text": "{{_local.forgotError}}"
              },
              {
                "type": "basic",
                "name": "Label",
                "props": {
                  "htmlFor": "forgot_email",
                  "className": "glitter-form-label"
                },
                "text": "$t:auth.email"
              },
              {
                "type": "basic",
                "name": "Input",
                "props": {
                  "id": "forgot_email",
                  "name": "email",
                  "type": "email",
                  "autoComplete": "email",
                  "required": true,
                  "disabled": "{{_local.isSubmitting}}",
                  "className": "glitter-form-input"
                }
              },
              {
                "type": "basic",
                "name": "P",
                "if": "{{_local.forgotErrors?.email}}",
                "props": {
                  "className": "glitter-form-message glitter-form-message-error"
                },
                "text": "{{Array.isArray(_local.forgotErrors.email) ? _local.forgotErrors.email[0] : _local.forgotErrors.email}}"
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "submit",
                  "disabled": "{{_local.isSubmitting}}",
                  "className": "glitter-solid glitter-action-link"
                },
                "text": "$t:auth.forgot_password_submit"
              }
            ],
            "actions": [
              {
                "type": "submit",
                "handler": "sequence",
                "actions": [
                  {
                    "handler": "setState",
                    "params": {
                      "target": "local",
                      "isSubmitting": true,
                      "forgotError": null,
                      "forgotErrors": null
                    }
                  },
                  {
                    "handler": "apiCall",
                    "auth_required": false,
                    "target": "/api/auth/forgot-password",
                    "params": {
                      "method": "POST",
                      "body": {
                        "email": "{{form.email}}"
                      }
                    },
                    "onSuccess": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "isSubmitting": false,
                          "success": true
                        }
                      }
                    ],
                    "onError": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "isSubmitting": false,
                          "forgotError": "{{error.message ?? ''}}",
                          "forgotErrors": "{{error.response?.errors ?? error.errors}}"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "P",
            "props": {
              "className": "glitter-auth-switch glitter-recovery-return"
            },
            "children": [
              {
                "type": "basic",
                "name": "A",
                "props": {
                  "href": "/login",
                  "className": "glitter-text-link"
                },
                "text": "$t:auth.login_link"
              }
            ]
          }
        ]
      }
    ]
  }
}
