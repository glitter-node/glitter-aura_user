{
  "version": "1.0.1",
  "layout_name": "community/index",
  "extends": "_user_base",
  "meta": { "title": "$t:community.index_title" },
  "data_sources": [
    { "id": "communityBoard", "label_key": "$t:community.board_data_source", "type": "api", "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}?include_user_abilities=true", "method": "GET", "params": {}, "auto_fetch": true, "auth_mode": "optional", "loading_strategy": "blocking", "refetchOnMount": true },
    { "id": "communityPosts", "label_key": "$t:community.data_source", "type": "api", "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}/posts", "method": "GET", "params": { "page": "{{query?.page ?? 1}}", "per_page": "{{query?.per_page ?? 15}}", "search": "{{query?.q ?? ''}}", "category": "{{query?.category ?? ''}}" }, "auto_fetch": true, "auth_mode": "optional", "loading_strategy": "progressive", "refetchOnMount": true }
  ],
  "slots": { "content": [{ "type": "basic", "name": "Section", "props": { "className": "glitter-container glitter-section glitter-page-shell glitter-community-page" }, "children": [
    { "type": "composite", "name": "GlitterSectionHeader", "if": "{{!communityBoard?.data && !communityBoard?.loading && !communityBoard?.error}}", "props": { "eyebrow": "$t:community.kicker", "title": "$t:community.title", "description": "$t:community.intro", "headingLevel": "h1" } },
    { "type": "composite", "name": "GlitterSectionHeader", "if": "{{communityBoard?.loading}}", "props": { "eyebrow": "$t:community.kicker", "title": "$t:community.loading_title", "description": "$t:community.loading_intro", "headingLevel": "h1" } },
    { "type": "composite", "name": "GlitterSectionHeader", "if": "{{communityBoard?.error}}", "props": { "eyebrow": "$t:community.kicker", "title": "$t:community.error_title", "description": "$t:community.error_intro", "headingLevel": "h1" } },
    { "type": "composite", "name": "GlitterSectionHeader", "if": "{{communityBoard?.data}}", "props": { "eyebrow": "$t:community.board_kicker", "title": "{{communityBoard.data.name}}", "description": "{{communityBoard.data.description ?? ''}}", "headingLevel": "h1" } },
    { "type": "basic", "name": "A", "if": "{{communityBoard?.data}}", "props": { "href": "/content", "className": "glitter-text-link glitter-community-content-link" }, "text": "$t:community.back_to_content" },
    { "type": "basic", "name": "Div", "if": "{{communityBoard?.data}}", "props": { "className": "glitter-community-context" }, "children": [{ "type": "basic", "name": "Span", "if": "{{communityBoard.data.posts_count !== null && communityBoard.data.posts_count !== undefined}}", "text": "$t:community.posts_count|count={{communityBoard.data.posts_count}}" }] },
    { "type": "basic", "name": "Form", "if": "{{communityBoard?.data}}", "props": { "className": "glitter-search-form glitter-community-search-form", "role": "search" }, "actions": [{ "type": "submit", "handler": "navigate", "params": { "path": "/community/{{route.slug}}", "mergeQuery": false, "query": { "q": "{{$event.target.q.value}}", "page": 1 } } }], "children": [{ "type": "basic", "name": "Label", "props": { "htmlFor": "glitter-community-search-query", "className": "glitter-sr-only" }, "text": "$t:community.search_label" }, { "type": "basic", "name": "Input", "props": { "id": "glitter-community-search-query", "name": "q", "type": "search", "value": "{{query?.q ?? ''}}", "className": "glitter-search-input", "placeholder": "$t:community.search_placeholder" } }, { "type": "basic", "name": "Button", "props": { "type": "submit", "className": "glitter-solid glitter-action-link" }, "text": "$t:community.search_submit" }, { "type": "basic", "name": "A", "if": "{{query?.q}}", "props": { "href": "/community/{{route.slug}}", "className": "glitter-text-link glitter-community-search-clear" }, "text": "$t:community.search_clear" }] },
    { "type": "basic", "name": "A", "if": "{{communityBoard?.data?.user_abilities?.can_write === true}}", "props": { "href": "/community/{{route.slug}}/write", "className": "glitter-solid glitter-action-link glitter-community-write" }, "text": "$t:community.write" },
    { "type": "basic", "name": "Div", "if": "{{communityBoard?.error}}", "props": { "className": "glitter-state glitter-state-error", "role": "alert" }, "children": [{ "type": "basic", "name": "P", "text": "$t:community.board_error" }, { "type": "basic", "name": "Button", "props": { "type": "button", "className": "glitter-text-button" }, "actions": [{ "type": "click", "handler": "refetchDataSource", "params": { "dataSourceId": "communityBoard" } }], "text": "$t:state.retry" }] },
    { "type": "basic", "name": "Div", "if": "{{communityBoard?.data && communityPosts?.loading}}", "props": { "className": "glitter-state", "role": "status", "aria-live": "polite" }, "children": [{ "type": "basic", "name": "P", "text": "$t:state.loading" }] },
    { "type": "basic", "name": "Div", "if": "{{communityBoard?.data && communityPosts?.error}}", "props": { "className": "glitter-state glitter-state-error", "role": "alert" }, "children": [{ "type": "basic", "name": "P", "text": "$t:state.error" }, { "type": "basic", "name": "Button", "props": { "type": "button", "className": "glitter-text-button" }, "actions": [{ "type": "click", "handler": "refetchDataSource", "params": { "dataSourceId": "communityPosts" } }], "text": "$t:state.retry" }] },
    { "type": "basic", "name": "Div", "if": "{{communityBoard?.data && !communityPosts?.loading && !communityPosts?.error && (communityPosts?.data?.data?.length ?? 0) === 0}}", "props": { "className": "glitter-state glitter-state-empty" }, "children": [{ "type": "basic", "name": "P", "if": "{{query?.q}}", "text": "$t:community.search_empty" }, { "type": "basic", "name": "P", "if": "{{!query?.q}}", "text": "$t:community.empty" }, { "type": "basic", "name": "A", "if": "{{query?.q}}", "props": { "href": "/community/{{route.slug}}", "className": "glitter-text-link glitter-community-search-clear", "aria-label": "$t:community.search_clear" }, "text": "$t:community.search_clear" }] },
    { "type": "basic", "name": "Div", "if": "{{communityBoard?.data && communityPosts?.data?.data?.length > 0}}", "props": { "className": "glitter-post-list glitter-community-list" }, "children": [{ "type": "basic", "name": "Article", "iteration": { "source": "{{communityPosts?.data?.data ?? []}}", "item_var": "post", "index_var": "idx" }, "props": { "className": "glitter-post-item" }, "children": [{ "type": "basic", "name": "A", "props": { "href": "/community/{{route.slug}}/{{post.id}}", "className": "glitter-post-link" }, "children": [{ "type": "basic", "name": "Div", "props": { "className": "glitter-community-post-heading" }, "children": [{ "type": "basic", "name": "Span", "props": { "className": "glitter-community-post-number" }, "text": "{{post.number ?? ''}}" }, { "type": "basic", "name": "Div", "props": { "className": "glitter-post-heading" }, "children": [{ "type": "basic", "name": "Span", "if": "{{post.is_notice}}", "props": { "className": "glitter-community-post-state" }, "text": "$t:community.notice" }, { "type": "basic", "name": "Span", "if": "{{post.is_new}}", "props": { "className": "glitter-community-post-state" }, "text": "$t:community.new" }, { "type": "basic", "name": "Span", "if": "{{post.category}}", "props": { "className": "glitter-post-category" }, "text": "{{post.category}}" }, { "type": "basic", "name": "H2", "props": { "className": "glitter-post-title" }, "text": "{{post.title}}" }] }] }, { "type": "basic", "name": "P", "if": "{{post.content_preview}}", "props": { "className": "glitter-post-excerpt" }, "text": "{{post.content_preview}}" }, { "type": "basic", "name": "Div", "props": { "className": "glitter-post-meta" }, "children": [{ "type": "basic", "name": "Span", "text": "{{post.author?.name ?? ''}}" }, { "type": "basic", "name": "Time", "props": { "datetime": "{{post.created_at ?? ''}}" }, "text": "{{post.created_at_formatted ?? post.created_at ?? ''}}" }, { "type": "basic", "name": "Span", "text": "$t:community.views|count={{post.view_count ?? 0}}" }, { "type": "basic", "name": "Span", "text": "$t:community.comments|count={{post.comment_count ?? 0}}" }, { "type": "basic", "name": "Span", "if": "{{post.has_attachment}}", "text": "$t:community.attachments|count={{post.attachment_count ?? 0}}" }, { "type": "basic", "name": "Span", "if": "{{post.reply_count > 0}}", "text": "$t:community.replies|count={{post.reply_count}}" }] }] }] }] },
    { "type": "composite", "name": "Pagination", "if": "{{communityBoard?.data && communityPosts?.data?.pagination}}", "props": { "currentPage": "{{communityPosts?.data?.pagination?.current_page ?? 1}}", "totalPages": "{{communityPosts?.data?.pagination?.last_page ?? null}}", "hasMorePages": "{{communityPosts?.data?.pagination?.has_more_pages ?? false}}", "className": "glitter-pagination" }, "actions": [{ "event": "onPageChange", "handler": "navigate", "params": { "path": "/community/{{route.slug}}", "mergeQuery": true, "query": { "page": "{{$args[0]}}" } } }] }
  ] }] }
}
